# Sao chép file này thành .env và điền giá trị thật.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4

# Timeout mỗi lời gọi, tính bằng giây.
# Model suy luận (reasoning) có thể cần 60-180s cho một câu trả lời.
# Đặt quá thấp sẽ báo lỗi timeout; quá cao sẽ khiến UI chờ lâu.
LLM_TIMEOUT=120

# Số lần thử lại khi lỗi. 0 = trả lỗi ngay (khuyến nghị khi đang gỡ lỗi).
LLM_MAX_RETRIES=0

# ============================================================
# Google Calendar (tuỳ chọn — chỉ cần khi muốn đồng bộ lịch)
# ============================================================
# Tạo ở Google Cloud Console: APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Application type: Desktop app
# Redirect URI khai báo trong Google Cloud phải là: http://localhost:8765/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_PORT=8765

# File lưu token. Nằm trong data/ nên đã bị .gitignore chặn.
# File này chứa refresh token — coi như mật khẩu, đừng chia sẻ.
GOOGLE_TOKEN_PATH=data/google_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIME_ZONE=Asia/Ho_Chi_Minh